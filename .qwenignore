# Qwen Code search/ignore file (project-root relative).
# Complements .gitignore (Qwen already respects it) and keeps file search,
# glob, @-completion, and read_many_files away from generated output.
#
# Never ignore source, tests, agent docs, or product docs. Only add generated
# or machine-local paths here.

# Build output
**/bin/
**/obj/
**/node_modules/
**/dist/
**/TestResults/
**/coverage/
*.tsbuildinfo

# local-ai-infra runtime/generated output (schemas and examples stay visible)
local-ai-infra/telemetry/runs/
local-ai-infra/telemetry/errors/
local-ai-infra/telemetry/escalations/
local-ai-infra/telemetry/spans/
local-ai-infra/benchmarks/results/
local-ai-infra/evals/results/
local-ai-infra/datasets/accepted/
local-ai-infra/datasets/candidates/
local-ai-infra/datasets/rejected/

# Caches, local state, and logs
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
**/.qwen/
*.log
