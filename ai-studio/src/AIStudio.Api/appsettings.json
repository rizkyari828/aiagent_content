{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Ai": {
    "Provider": "Ollama"
  },
  "GpuResourceGate": {
    "Enabled": true
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "DefaultModel": "qwen3.8:27b-q4_K_M",
    "TimeoutSeconds": 600
  },
  "Assets": {
    "RootPath": "assets"
  },
  "Rendering": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TimeoutSeconds": 600,
    "Width": 1280,
    "Height": 720,
    "FrameRate": 30,
    "EnableMotion": true,
    "Transition": "Crossfade",
    "TransitionDurationSeconds": 0.35,
    "BackgroundMusicVolume": 0.28,
    "EnableDucking": true
  },
  "AudioMixing": {
    "SampleRate": 48000,
    "Channels": 2,
    "NarrationLoudnessTarget": -16,
    "NarrationTruePeak": -1.5,
    "NarrationLoudnessRange": 11,
    "MusicLoudnessTarget": -24,
    "MusicTruePeak": -3,
    "MusicLoudnessRange": 7,
    "EnableDucking": true,
    "DuckThreshold": 0.05,
    "DuckRatio": 4,
    "DuckAttackMs": 20,
    "DuckReleaseMs": 400,
    "FadeInSeconds": 1,
    "FadeOutSeconds": 1.5,
    "LimiterCeilingDb": -1
  },
  "Manim": {
    "Enabled": false,
    "PythonPath": "python3",
    "ScriptPath": "Rendering/Manim/render_scene.py",
    "TimeoutSeconds": 600
  },
  "ComfyUi": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:8188",
    "WorkflowPath": "Rendering/ComfyUI/flux2_klein_4b_distilled.json",
    "ImageEditWorkflowPath": "Rendering/ComfyUI/flux2_klein_4b_distilled_edit.json",
    "TimeoutSeconds": 600,
    "Width": 1280,
    "Height": 720
  },
  "Blender": {
    "Enabled": false,
    "ExecutablePath": "blender",
    "TemplateDirectory": "Rendering/Blender/templates",
    "TimeoutSeconds": 1800,
    "RenderEngine": "CYCLES",
    "ComputeBackend": "CUDA",
    "Samples": 16,
    "Width": 1280,
    "Height": 720,
    "FramesPerSecond": 30
  },
  "SpeechSynthesis": {
    "Enabled": false,
    "VoxCpm2": {
      "PythonExecutable": "python3",
      "ModelPath": "",
      "ScriptPath": "Rendering/VoxCPM2/synthesize.py",
      "TimeoutSeconds": 600,
      "InferenceTimesteps": 20,
      "CfgValue": 2.0,
      "Normalize": true,
      "ExpectedSampleRate": 48000
    }
  },
  "MusicGeneration": {
    "Enabled": false,
    "AceStep": {
      "PythonExecutable": "python3",
      "ProjectRoot": "",
      "Model": "acestep-v15-turbo",
      "ScriptPath": "Rendering/ACE-Step/generate.py",
      "TimeoutSeconds": 900,
      "InferenceSteps": 8,
      "ExpectedSampleRate": 48000,
      "ExpectedChannels": 2
    }
  },
  "JobWorker": {
    "Enabled": false,
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:02:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
