{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Ai": {
    "Provider": "Ollama"
  },
  "Ollama": {
    "BaseUrl": "http://127.0.0.1:11434",
    "DefaultModel": "qwen3.8:27b-q4_K_M",
    "TimeoutSeconds": 600
  },
  "Assets": {
    "RootPath": "assets"
  },
  "Rendering": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "TimeoutSeconds": 600,
    "Width": 1280,
    "Height": 720,
    "FrameRate": 30,
    "EnableMotion": true,
    "Transition": "Crossfade",
    "TransitionDurationSeconds": 0.35,
    "BackgroundMusicVolume": 0.28,
    "EnableDucking": true
  },
  "Manim": {
    "Enabled": false,
    "PythonPath": "python3",
    "ScriptPath": "Rendering/Manim/render_scene.py",
    "TimeoutSeconds": 600
  },
  "ComfyUi": {
    "Enabled": false,
    "BaseUrl": "http://127.0.0.1:8188",
    "WorkflowPath": "Rendering/ComfyUI/flux2_klein_4b_distilled.json",
    "TimeoutSeconds": 600,
    "Width": 1280,
    "Height": 720
  },
  "Blender": {
    "Enabled": false,
    "ExecutablePath": "blender",
    "TemplateDirectory": "Rendering/Blender/templates",
    "TimeoutSeconds": 1800,
    "RenderEngine": "CYCLES",
    "ComputeBackend": "CUDA",
    "Samples": 16,
    "Width": 1280,
    "Height": 720,
    "FramesPerSecond": 30
  },
  "JobWorker": {
    "Enabled": false,
    "PollInterval": "00:00:01",
    "LeaseDuration": "00:02:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]"
}
