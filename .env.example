# Copy to .env for Docker Compose. Source it before running the API.
POSTGRES_DB=aistudio
POSTGRES_USER=aistudio
POSTGRES_PASSWORD=change-me-local
POSTGRES_PORT=5432

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://127.0.0.1:5002
ConnectionStrings__DefaultConnection="Host=localhost;Port=${POSTGRES_PORT};Database=${POSTGRES_DB};Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"

Ai__Provider=Ollama
Ollama__BaseUrl=http://127.0.0.1:11434
Ollama__DefaultModel=gemma3:4b
Ollama__TimeoutSeconds=120
